# Paths are relative to this file: the Python project lives in backend/ (see README.md).

# Virtual environment
.venv/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/

# Config secrets (never commit real tokens/keys)
backend/config/*.yaml
!backend/config/config.example.yaml
.env
.env.*
!.env.example

# Python build/test artifacts
build/
dist/
.mypy_cache/
.coverage
htmlcov/
.tox/

# Editors / IDE
.vscode/
.idea/
*.swp

# Logs / local data
*.log

# Local extraction/run artifacts (review only, not source)
outputs/

# Learned-style example articles (local only; distilled into a StyleProfile)
backend/api/styles/examples/*
!backend/api/styles/examples/.gitkeep
!backend/api/styles/examples/README.md

# OS
.DS_Store

#Architecture file
diagrams/

#doc except for the mcq server doc
backend/docs/*
!backend/docs/sci_comm_mcpdoc.md

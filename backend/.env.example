# Copy to .env (gitignored) and fill in. Loaded automatically by
# api/config_loader.py on import — no `export` needed. An exported shell var
# overrides the .env value.

# Gemini free tier (Google AI Studio) — used by the extractor role.
# Get a key at https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=

# Other providers (only if a role uses them):
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Optional: set model roles via env instead of config/config.yaml.
# config.yaml takes precedence; "env" placeholders there fall back to these.
# EXTRACTOR_PROVIDER=google_genai
# EXTRACTOR_MODEL=gemini-2.5-flash

# Optional: evaluation dashboard (Langfuse Cloud). With both keys set, every LLM
# call is traced (tokens / latency / cost per role) and runs + user feedback are
# scored; without them telemetry is off and nothing is sent. Prompts and paper
# text DO leave the machine when this is on.
# Keys: https://cloud.langfuse.com -> your project -> Settings -> API Keys
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com   # US region: https://us.cloud.langfuse.com
# TELEMETRY_ENABLED=false                    # force off even with keys set

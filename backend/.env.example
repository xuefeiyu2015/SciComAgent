# Copy to .env (gitignored) and fill in. Loaded automatically by
# api/config_loader.py on import — no `export` needed. An exported shell var
# overrides the .env value.

# Gemini free tier (Google AI Studio) — used by the extractor role.
# Get a key at https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=

# Other providers (only if a role uses them):
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Optional: set model roles via env instead of config/config.yaml.
# config.yaml takes precedence; "env" placeholders there fall back to these.
# EXTRACTOR_PROVIDER=google_genai
# EXTRACTOR_MODEL=gemini-2.5-flash
